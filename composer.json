{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "career180/instructor-revenue-ledger",
    "type": "project",
    "description": "Instructor Revenue Ledger: subscription revenue allocation, refunds and idempotent instructor payouts (Laravel 11, Filament v3, Pest).",
    "keywords": [
        "laravel",
        "filament",
        "ledger",
        "payouts",
        "idempotency"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3.55",
        "laravel/framework": "^11.56",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {
                "PKSA-mdq4-51ck-6kdq": "Laravel 11 is EOL; fix only exists in 12.60+/13.10+. Brief requires Laravel 11. See README > Security note.",
                "PKSA-3r5d-mb8f-1qw9": "Laravel 11 is EOL; fix only exists in 12.60+/13.10+. Brief requires Laravel 11. See README > Security note.",
                "PKSA-m5cs-t1y6-qpcs": "Laravel 11 is EOL; fix only exists in 12.60+/13.10+. Brief requires Laravel 11. See README > Security note.",
                "PKSA-zwc5-qtrz-zm1n": "Laravel 11 is EOL; fix only exists in 12.60+/13.10+. Brief requires Laravel 11. See README > Security note."
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
